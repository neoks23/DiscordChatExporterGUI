<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

	<Grid HorizontalAlignment="Center"
          Height="400"
          Width="780"
          ShowGridLines="False"
          Margin="0,17,0,17">

		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="100"/>
			<ColumnDefinition Width="Auto"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>

		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="24"/>
			<RowDefinition Height="24"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="8"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="8"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="8"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="8"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<Button Content="Toggle Visiblity"
                Grid.Row="0"
                Grid.Column="0"
                Height="32"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Click="btnAuth"/>

		<TextBlock Grid.Row="0"
                   Grid.Column="2"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Text="Discord Chat Exporter Utility"
                   TextWrapping="Wrap"
                   FontWeight="Bold"
                   FontSize="24"/>

		<Label Content="Enter token: " HorizontalAlignment="Left" Grid.Row="1" VerticalAlignment="Top"/>
		<TextBox Grid.Column="2"  x:Name="txtToken" HorizontalAlignment="Left" Grid.Row="1" TextWrapping="Wrap" VerticalAlignment="Center" Width="300" TextChanged="txtToken_TextChanged"/>

		<GroupBox x:Name="ExportGroup"
                  Header="Export Settings"
                  Grid.Row="3"
                  Grid.Column="0"
                  Grid.ColumnSpan="3"
                  Grid.RowSpan="9"
                  Margin="0,0,0,0"
                  Visibility="Visible">

			<Grid Margin="8">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="80"/>
					<ColumnDefinition Width="16"/>
					<ColumnDefinition Width="*"/>
				</Grid.ColumnDefinitions>

				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="8"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="8"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="8"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="8"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="8"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="8"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="8"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="8"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>

				<Button Content="Dms"
                        Grid.Row="0"
                        Grid.Column="0"
                        Width="80"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Click="btnDms"/>

				<Label Content="Enter channel: " HorizontalAlignment="Left" Grid.Row="0" Grid.Column="2" VerticalAlignment="Top"/>
				<TextBox x:Name="txtChannel"
                          Grid.Column="2"
                          Width="228"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center" TextChanged="txtChannel_TextChanged" Margin="88,0,0,0"
                          
                          />

				<Button Content="Channels"
                        Grid.Row="2"
                        Grid.Column="0"
                        Width="80"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Click="btnChannels"/>

				<CheckBox x:Name="chkExportAll"
                          Grid.Row="4"
                          Grid.Column="0"
                          Width="80"
                          VerticalAlignment="Center"
                          FlowDirection="RightToLeft"
                          Content="ExportAll"/>

				<ComboBox x:Name="cbbFormat"
                          Grid.Row="6"
                          Grid.Column="0"
                          Width="80"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Top"/>

				<Button Content="Export"
                        Grid.Row="8"
                        Grid.Column="0"
                        Width="80"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Click="btnExport"/>
				<Button Content="View Output"
                        Grid.Row="10"
                        Grid.Column="0"
                        Width="80"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Click="btnOutput"/>
				
				<DatePicker
                    x:Name="dtpBeforeTime"
                    Grid.Row="12"
                    Width="80"
                    HorizontalAlignment="Center"
                    SelectedDate="2026-05-1"
                    SelectedDateChanged="DtpBeforeTime_SelectedDateChanged"
                    />
				
				<DatePicker
                    x:Name="dtpAfterTime"
                    Grid.Row="14"
                    Width="80"
                    HorizontalAlignment="Center"
                    SelectedDate="2026-05-11"
                    SelectedDateChanged="DtpAfterTime_SelectedDateChanged"
                    />



				<Button Content="Parse JSON"
                        Grid.Row="16"
                        Grid.Column="0"
                        Width="80"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Click="btnParseJSON"/>



				<TextBox x:Name="txtConsole"
                         Grid.Row="2"
                         Grid.Column="2"
                         Grid.RowSpan="15"
                         MaxHeight="200"
                         MinWidth="300"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         IsReadOnly="True"
                         FontFamily="Consolas"
                         Background="Black"
                         Foreground="LightGreen"
                         BorderBrush="Gray"
                         Text="[cmd] ready..." ScrollViewer.CanContentScroll="True" Margin="0,0,0,20" />
				<Label Content="Enter server ID: " HorizontalAlignment="Left" Grid.Column="2" VerticalAlignment="Center" Margin="321,0,0,0"/>
				<TextBox x:Name="txtServer"
                    Grid.Column="2"
                    Width="228"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center" TextChanged="txtServer_TextChanged" Margin="418,0,0,0"
                          
                          />
			</Grid>
		</GroupBox>
	</Grid>
</Window>